# PostgreSQL settings. Create the origin_db database in pgAdmin first.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=origin_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_your_postgres_password

# Set a long, private value before using protected API endpoints.
# Keep this secret. Do not commit your real .env file.
ADMIN_API_KEY=replace_with_a_long_random_secret
